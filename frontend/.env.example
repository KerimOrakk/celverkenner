# Kopieer naar .env als de API niet op http://localhost:8000 draait.
VITE_API_URL=http://localhost:8000

# Optioneel: bezoekersstatistieken (Umami) en foutmeldingen (Sentry).
# Leeg laten = geen externe scripts. Zie README, "Statistieken en foutmeldingen".
VITE_UMAMI_SRC=
VITE_UMAMI_ID=
VITE_SENTRY_LOADER=

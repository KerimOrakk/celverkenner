{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: uvicorn",
      "type": "shell",
      "command": "uvicorn main:app --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "celverkenner" }
    },
    {
      "label": "Frontend: vite",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "celverkenner" }
    },
    {
      "label": "Start alles",
      "dependsOn": ["Backend: uvicorn", "Frontend: vite"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "runOptions": { "runOn": "default" }
    }
  ]
}
